# SMTP credentials used to email repair booking requests to the admin inbox.
# Copy this file to .env.local and fill in real values (never commit .env.local).

# Your mail provider's SMTP host, e.g. smtp.gmail.com, smtp.office365.com, smtp.your-domain.com
SMTP_HOST=
# 465 for implicit TLS, 587 for STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address the booking emails are sent FROM (often the same as SMTP_USER)
SMTP_FROM="V&M Vape | Mobile <bookings@example.com>"
# Address the booking emails are sent TO
ADMIN_EMAIL=admin@example.com
