# SMTP credentials used to email repair booking requests to the admin inbox.
# Copy this file to .env.local and fill in real values (never commit .env.local).

# Your mail provider's SMTP host, e.g. smtp.gmail.com, smtp.office365.com, smtp.your-domain.com
SMTP_HOST=
# 465 for implicit TLS, 587 for STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address the booking emails are sent FROM (often the same as SMTP_USER)
SMTP_FROM="V&M Vape | Mobile <bookings@example.com>"
# Address the booking emails are sent TO
ADMIN_EMAIL=admin@example.com

# --- Admin dashboard (/admin) ---
# Shared password for the admin dashboard login.
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Supabase (see supabase/README.md) ---
# Project URL and anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. Never expose
# this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
